meta {
  name: GROUPS ID RULES
  type: http
  seq: 2
}

get {
  url: https://{{peprimary}}:4433/classifier-api/v1/groups/{{groupid}}/rules
  body: none
  auth: none
}

headers {
  X-AUTHENTICATION: {{rbactoken}}
}

vars:pre-request {
  groupid: 5ea9e669-b403-46e4-8d2d-2d16094e3d37
}

docs {
  Resolve the rules for a specific node group, and then translate those rules to work with the PuppetDB nodes and inventory endpoints.
  
  https://www.puppet.com/docs/pe/2023.8/groups_endpoint#get-v1-groups-id-rules
}
