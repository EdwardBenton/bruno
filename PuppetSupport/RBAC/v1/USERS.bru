meta {
  name: USERS
  type: http
  seq: 1
}

get {
  url: https://{{peprimary}}:4433/rbac-api/v1/users
  body: none
  auth: inherit
}

headers {
  X-AUTHENTICATION: {{rbactoken}}
}

settings {
  encodeUrl: true
}

docs {
  Fetches all local and remote users, including the superuser. You can also query specific users by user ID.
  
  
  https://help.puppet.com/pe/2023.8/topics/rbac_api_v1_user_get_users.htm
}
